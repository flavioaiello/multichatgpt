#!/usr/bin/env python3
"""Create independent, named desktop profiles without copying account data."""
import argparse
import fcntl
import json
from pathlib import Path
import plistlib
import random
import shlex
import shutil
import subprocess
import tempfile

VERSION = "0.2.1"
NAMES = ("Twilight", "Rainbow", "Pinkie", "Fluttershy", "Rarity",
         "Applejack", "Starlight", "Sunset", "Luna", "Celestia",
         "Sweetie", "Scootaloo", "Bloom", "Trixie", "Derpy", "Shining", "Cadance")
BUNDLE_ID = "com.openai.codex"
ROOT = Path(__file__).resolve().parent.parent


def read_plist(app):
    with (app / "Contents/Info.plist").open("rb") as stream:
        return plistlib.load(stream)


def find_app(explicit=None):
    candidates = [Path(explicit).expanduser()] if explicit else [
        app for folder in (Path("/Applications"), Path.home() / "Applications")
        for app in sorted(folder.glob("*.app"))]
    for app in candidates:
        try:
            info = read_plist(app)
            executable = info.get("CFBundleExecutable", "")
            if (info.get("CFBundleIdentifier") == BUNDLE_ID and executable
                    and (app / "Contents/MacOS" / executable).is_file()):
                return app.resolve(), info
        except (OSError, plistlib.InvalidFileException):
            continue
    raise ValueError("Compatible ChatGPT/Codex app (com.openai.codex) not found. Use --app PATH.")


def choose_name(applications, profiles):
    names = list(NAMES)
    random.SystemRandom().shuffle(names)
    for suffix in range(1, 10000):
        for pony in names:
            name = pony if suffix == 1 else f"{pony} {suffix}"
            slug = name.lower().replace(" ", "-")
            if not (applications / f"ChatGPT {name}.app").exists() and not (profiles / slug).exists():
                return name, slug
    raise ValueError("No available profile name.")


def launcher_script(executable, profile):
    return f'''#!/bin/zsh
set -eu
umask 077
profile_root={shlex.quote(str(profile))}
mkdir -p "$profile_root/codex" "$profile_root/browser"
bundle_root="${{0:A:h:h}}"
export CODEX_HOME="$profile_root/codex"
exec "$bundle_root/MacOS/"{shlex.quote(executable)} "--user-data-dir=$profile_root/browser" </dev/null >>"$profile_root/launcher.log" 2>&1
'''


def install_native(destination):
    prebuilt = ROOT / "profile-launcher"
    if prebuilt.is_file():
        shutil.copy2(prebuilt, destination)
    else:
        subprocess.run(["/usr/bin/xcrun", "clang", "-Wall", "-Wextra", "-Werror",
                        "-arch", "arm64", "-arch", "x86_64", "-mmacosx-version-min=11.0",
                        str(ROOT / "src/launcher.c"), "-o", str(destination)], check=True)
    destination.chmod(0o755)


def build_bundle(source, source_info, app, name, slug, profile):
    # APFS copies share storage until modified. Other volumes use a normal copy.
    copied = subprocess.run(["/bin/cp", "-cR", str(source), str(app)], capture_output=True)
    if copied.returncode:
        if app.exists():
            shutil.rmtree(app)
        subprocess.run(["/usr/bin/ditto", str(source), str(app)], check=True)
    macos = app / "Contents/MacOS"
    resources = app / "Contents/Resources"
    resources.mkdir(exist_ok=True)
    executable = source_info["CFBundleExecutable"]
    if Path(executable).name != executable or executable == "profile-launcher":
        raise ValueError("Unsupported source executable name.")
    install_native(macos / "profile-launcher")
    (resources / "launch-profile.sh").write_text(launcher_script(executable, profile))
    info = dict(source_info)
    info.update({"CFBundleExecutable": "profile-launcher",
                 "CFBundleIdentifier": f"local.multichatgpt.{slug}",
                 "CFBundleName": f"ChatGPT {name}",
                 "CFBundleDisplayName": f"ChatGPT {name}",
                 "MultichatgptVersion": VERSION})
    # Clones must not replace the original app's global file/link handlers.
    for field in ("CFBundleURLTypes", "CFBundleDocumentTypes", "CFBundleAlternateNames", "LSUIElement"):
        info.pop(field, None)
    with (app / "Contents/Info.plist").open("wb") as stream:
        plistlib.dump(info, stream)
    binary = macos / executable
    # Local signature for the copied executable; nested vendor code is unchanged.
    subprocess.run(["/usr/bin/codesign", "--force", "--sign", "-", str(binary)], check=True)
    subprocess.run(["/usr/bin/codesign", "--force", "--sign", "-", str(app)], check=True)
    subprocess.run(["/usr/bin/codesign", "--verify", "--deep", "--strict", str(app)], check=True)


def clone(args):
    source, source_info = find_app(args.app)
    applications = Path(args.applications_dir).expanduser().resolve()
    data = Path(args.data_dir).expanduser().resolve()
    applications.mkdir(parents=True, exist_ok=True)
    profiles = data / "profiles"
    profiles.mkdir(parents=True, exist_ok=True, mode=0o700)
    with (data / ".clone.lock").open("a") as lock:
        fcntl.flock(lock, fcntl.LOCK_EX)
        name, slug = choose_name(applications, profiles)
        target = applications / f"ChatGPT {name}.app"
        profile = profiles / slug
        profile.mkdir(mode=0o700)
        try:
            (profile / "codex").mkdir(mode=0o700)
            (profile / "browser").mkdir(mode=0o700)
            with tempfile.TemporaryDirectory(prefix=".multichatgpt-", dir=applications) as temp:
                app = Path(temp) / target.name
                build_bundle(source, source_info, app, name, slug, profile)
                metadata = {"id": slug, "name": name, "app": str(target),
                            "profile": str(profile), "source": str(source), "version": VERSION}
                (profile / "profile.json").write_text(json.dumps(metadata, indent=2) + "\n")
                app.rename(target)
        except BaseException:
            shutil.rmtree(profile)
            raise
    print(f"Created: {target}\nProfile: {profile}\nOpen with: multichatgpt open {shlex.quote(name)}")
    if args.open:
        subprocess.run(["/usr/bin/open", str(target)], check=True)


def records(data_dir):
    for path in sorted(Path(data_dir).expanduser().glob("profiles/*/profile.json")):
        yield json.loads(path.read_text())


def find_record(args):
    matches = [entry for entry in records(args.data_dir)
               if args.name.casefold() in (entry["name"].casefold(), entry["id"].casefold())]
    if len(matches) != 1:
        raise ValueError("Profile not found. Run multichatgpt list.")
    return matches[0]


def refresh(args):
    data = Path(args.data_dir).expanduser().resolve()
    with (data / ".clone.lock").open("a") as lock:
        fcntl.flock(lock, fcntl.LOCK_EX)
        entry = find_record(args)
        profile = Path(entry["profile"])
        target = Path(entry["app"])
        if target.is_symlink() or not target.is_dir():
            raise ValueError("Existing clone application not found.")
        if read_plist(target).get("CFBundleIdentifier") != f"local.multichatgpt.{entry['id']}":
            raise ValueError("Application identity does not match this profile.")
        source, info = find_app(args.app)
        processes = subprocess.check_output(["/bin/ps", "-axo", "args="], text=True)
        if any(str(target / "Contents/MacOS") in line or
               f"--user-data-dir={profile / 'browser'}" in line for line in processes.splitlines()):
            raise ValueError("Quit this clone before refreshing it.")
        with tempfile.TemporaryDirectory(prefix=".multichatgpt-", dir=target.parent) as temp:
            app = Path(temp) / target.name
            build_bundle(source, info, app, entry["name"], entry["id"], profile)
            backup = Path(temp) / "previous.app"
            target.rename(backup)
            try:
                app.rename(target)
            except BaseException:
                backup.rename(target)
                raise
        entry.update(source=str(source), version=VERSION)
        (profile / "profile.json").write_text(json.dumps(entry, indent=2) + "\n")
    subprocess.run(["/System/Library/Frameworks/CoreServices.framework/Frameworks/LaunchServices.framework/Support/lsregister",
                    "-f", str(target)], capture_output=True, check=False)
    print(f"Refreshed: {target}\nProfile: {profile}")


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--version", action="version", version=f"multichatgpt {VERSION}")
    commands = parser.add_subparsers(dest="command", required=True)
    create = commands.add_parser("clone", help="Create a fresh, randomly named profile launcher")
    create.add_argument("application", choices=["chatgpt"])
    create.add_argument("--app", help="Main application path (otherwise discovered automatically)")
    create.add_argument("--applications-dir", default=str(Path.home() / "Applications"))
    create.add_argument("--open", action="store_true", help="Open the new clone immediately")
    listing = commands.add_parser("list", help="List managed profiles")
    listing.add_argument("--json", action="store_true")
    opening = commands.add_parser("open", help="Open an existing clone by its name or ID")
    opening.add_argument("name")
    updating = commands.add_parser("refresh", help="Rebuild a closed clone using the current main app, keeping its profile")
    updating.add_argument("name")
    updating.add_argument("--app", help="Main application path (otherwise discovered automatically)")
    for command in (create, listing, opening, updating):
        command.add_argument("--data-dir", default=str(Path.home() / "Library/Application Support/multichatgpt"))
    args = parser.parse_args()
    try:
        if args.command == "clone":
            clone(args)
        elif args.command == "refresh":
            refresh(args)
        elif args.command == "list":
            entries = list(records(args.data_dir))
            if args.json:
                print(json.dumps(entries, indent=2))
            else:
                for entry in entries:
                    print(f"{entry['name']}\t{entry['app']}")
        else:
            entry = find_record(args)
            subprocess.run(["/usr/bin/open", entry["app"]], check=True)
    except (OSError, ValueError, subprocess.CalledProcessError) as error:
        parser.exit(1, f"multichatgpt: {error}\n")


if __name__ == "__main__":
    main()
